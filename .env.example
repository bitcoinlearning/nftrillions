# Cloudflare Worker Configuration
# After deploying your Cloudflare Worker, add your Worker URL here
# Example: VITE_CLOUDFLARE_WORKER_URL=https://treasury-proxy.YOUR-NAME.workers.dev
# Leave blank to use the default hybrid endpoint (dev mode)

VITE_CLOUDFLARE_WORKER_URL=

# Session Secret (already configured)
SESSION_SECRET=your-session-secret-here
